# Copy this file to .env and replace these values.
DATABASE_URL=jdbc:postgresql://localhost:5432/aeroflow_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace-with-your-local-postgres-password

# Paste the output of `openssl rand -base64 32` here (at least 32 decoded bytes).
# Startup fails if this is missing, blank, malformed, or too short.
# Production deployments should inject this through a secret manager.
JWT_SECRET_BASE64=

# Set these once to provision the first account in an empty database.
# Disable BOOTSTRAP_ADMIN_ENABLED again after the first successful startup.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional SMTP configuration for OTP email delivery.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_PROTOCOL=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
