# Copy this file to .env and replace these values.
DATABASE_URL=jdbc:postgresql://localhost:5432/aeroflow_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace-with-your-local-postgres-password

# Paste the output of `openssl rand -base64 32` here.
# Leave blank until you generate a key; the application rejects an empty value.
JWT_SECRET_BASE64=

# Optional SMTP configuration for OTP email delivery.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_PROTOCOL=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
